{
  "server": {
    "host": "127.0.0.1",
    "port": 3000,
    "enableCors": false
  },
  "storage": {
    "libraryRoots": [
      "D:\\NodeJS\\nasphoto\\data\\photos"
    ],
    "cacheDir": "D:\\NodeJS\\nasphoto\\data\\cache",
    "thumbnailDir": "D:\\NodeJS\\nasphoto\\data\\thumbs",
    "faceDir": "D:\\NodeJS\\nasphoto\\data\\faces",
    "memoryDir": "D:\\NodeJS\\nasphoto\\data\\memories",
    "tempDir": "D:\\NodeJS\\nasphoto\\data\\tmp"
  },
  "scan": {
    "cron": "0 0 * * *",
    "incremental": true,
    "ignoreHidden": true,
    "ignorePatterns": [
      "@eaDir",
      "#recycle",
      ".@__thumb",
      "@Recycle",
      "@Recently-Snapshot"
    ],
    "maxConcurrency": 1,
    "batchSize": 250
  },
  "thumbnails": {
    "sizes": [
      256
    ],
    "format": "jpeg",
    "quality": 82,
    "concurrency": 1,
    "regenerate": false,
    "videoSeekSeconds": 1,
    "videoKeyframesOnly": true,
    "ffmpegPath": "D:\\\\ffmpeg-8.0.1-essentials_build\\\\bin\\\\ffmpeg.exe"
  },
  "media": {
    "supportedImageExt": [
      ".jpg",
      ".jpeg",
      ".png",
      ".webp",
      ".heic",
      ".tif",
      ".tiff"
    ],
    "supportedVideoExt": [
      ".mp4",
      ".mov",
      ".m4v",
      ".mkv",
      ".avi",
      ".3gp"
    ],
    "preferExifTime": true
  },
  "faces": {
    "enabled": true,
    "scanCron": "30 0 * * *",
    "minFaceSize": 80,
    "cluster": {
      "eps": 0.45,
      "minSamples": 3
    }
  },
  "memories": {
    "enabled": true,
    "generateCron": "0 4 * * 6",
    "maxDurationSeconds": 90,
    "introSeconds": 3,
    "outroSeconds": 3,
    "musicDir": "D:\\NodeJS\\nasphoto\\data\\tmp"
  },
  "pwa": {
    "enabled": true,
    "offlineCacheDays": 365,
    "maxCacheEntries": 500
  },
  "tasks": {
    "workerIntervalSeconds": 5,
    "retry": {
      "maxAttempts": 3,
      "backoffSeconds": 60
    }
  },
  "logging": {
    "level": "info",
    "file": "D:\\NodeJS\\nasphoto\\data\\tmp\\app.log",
    "maxSizeMB": 10,
    "maxFiles": 5
  }
}
