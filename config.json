{
  "server": {
    "host": "0.0.0.0",
    "port": 3000,
    "enableCors": false
  },
  "storage": {
    "libraryRoots": [
      "./data/photos"
    ],
    "cacheDir": "./data/cache",
    "thumbnailDir": "./data/thumbs",
    "faceDir": "./data/faces",
    "memoryDir": "./data/memories",
    "tempDir": "./data/tmp"
  },
  "scan": {
    "cron": "0 0 * * *",
    "incremental": true,
    "ignoreHidden": true,
    "ignorePatterns": [
      "@eaDir",
      "#recycle",
      ".@__thumb",
      "@Recycle",
      "@Recently-Snapshot"
    ],
    "maxConcurrency": 1,
    "batchSize": 250
  },
  "thumbnails": {
    "sizes": [
      256,
      640
    ],
    "format": "jpeg",
    "quality": 82,
    "concurrency": 1,
    "regenerate": false,
    "videoSeekSeconds": 1,
    "videoKeyframesOnly": true,
    "ffmpegPath": "ffmpeg"
  },
  "media": {
    "supportedImageExt": [
      ".jpg",
      ".jpeg",
      ".png",
      ".webp",
      ".heic",
      ".tif",
      ".tiff"
    ],
    "supportedVideoExt": [
      ".mp4",
      ".mov",
      ".m4v",
      ".mkv",
      ".avi",
      ".3gp",
      ".3gpp"
    ],
    "preferExifTime": true
  },
  "faces": {
    "enabled": true,
    "scanCron": "30 0 * * *",
    "minFaceSize": 80,
    "cluster": {
      "eps": 0.45,
      "minSamples": 3
    }
  },
  "memories": {
    "enabled": true,
    "generateCron": "0 4 * * 6",
    "maxItemCount": 30,
    "musicDir": "./data/tmp"
  },
  "pwa": {
    "enabled": true,
    "offlineCacheDays": 365,
    "maxCacheEntries": 500
  },
  "tasks": {
    "workerIntervalSeconds": 5,
    "retry": {
      "maxAttempts": 3,
      "backoffSeconds": 60
    }
  },
  "logging": {
    "level": "info",
    "file": "./data/tmp/app.log",
    "maxSizeMB": 10,
    "maxFiles": 5
  }
}
